<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend account.move form to add Recompute US Tax button (fixes DCRO critical: no UI button for direct invoices) -->
    <record id="view_move_form_us_tax_recompute" model="ir.ui.view">
        <field name="name">account.move.form.us.tax.recompute</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_recompute_us_tax"
                        type="object"
                        string="Recompute US Tax"
                        class="oe_highlight"
                        invisible="not company_id.us_tax_enabled or move_type not in ('out_invoice', 'out_refund')"
                        help="Manually recompute US sales tax using the configured provider (local or hosted). Useful for direct invoices."/>
            </xpath>
        </field>
    </record>

    <!-- Optional: similar for sale.order if desired for visibility -->
    <record id="view_order_form_us_tax_recompute" model="ir.ui.view">
        <field name="name">sale.order.form.us.tax.recompute</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_recompute_us_tax"
                        type="object"
                        string="Recompute US Tax"
                        class="oe_highlight"
                        invisible="not company_id.us_tax_enabled"
                        help="Recompute US sales tax (typically auto on confirm, but manual for review)."/>
            </xpath>
        </field>
    </record>
</odoo>