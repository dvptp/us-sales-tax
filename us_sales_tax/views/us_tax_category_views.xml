<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_us_tax_category_tree" model="ir.ui.view">
        <field name="name">us.tax.category.tree</field>
        <field name="model">us.tax.category</field>
        <field name="arch" type="xml">
            <list string="Tax Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_us_tax_category_form" model="ir.ui.view">
        <field name="name">us.tax.category.form</field>
        <field name="model">us.tax.category</field>
        <field name="arch" type="xml">
            <form string="Tax Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" placeholder="FOOD_SNACK"/>
                        <field name="active"/>
                    </group>
                    <field name="description" placeholder="What this category covers..."/>
                    <field name="rule_ids" context="{'default_category_id': id}">
                        <list editable="bottom">
                            <field name="state_code"/>
                            <field name="taxable"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_us_tax_category" model="ir.actions.act_window">
        <field name="name">Tax Categories</field>
        <field name="res_model">us.tax.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
