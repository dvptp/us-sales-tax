<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_us_tax_rate_tree" model="ir.ui.view">
        <field name="name">us.tax.rate.tree</field>
        <field name="model">us.tax.rate</field>
        <field name="arch" type="xml">
            <list string="State Rates" editable="bottom">
                <field name="state_code"/>
                <field name="rate"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_us_tax_rate" model="ir.actions.act_window">
        <field name="name">State Rates (Local Provider)</field>
        <field name="res_model">us.tax.rate</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a state rate</p>
            <p>State-level rate approximations used by the built-in local provider.
               For rooftop (city/county/district) accuracy, switch to the hosted provider.</p>
        </field>
    </record>

</odoo>
